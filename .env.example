# .env.example
# Copy to ".env" and fill in real values.

# -----------------------------
# LLM Provider (Groq)
# -----------------------------
GROQ_API_KEY=your_groq_api_key_here
# Optional: override Groq model used by GroqLLM (if you add support for this in code)
# GROQ_MODEL=llama-3.3-70b-versatile


# -----------------------------
# RAG / Retrieval Tuning
# -----------------------------
APP_NAME=Chatbot API
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# If true, the API rebuilds the FAISS index automatically after ingestion/deletion.
AUTO_REBUILD_INDEX=true

# Minimum similarity score to keep a retrieved chunk.
MIN_RETRIEVAL_SCORE=0.25

# If true, /query will use LangChain (requires langchain* packages installed).
DEFAULT_USE_LANGCHAIN=false

# Max pages to OCR when a PDF looks scanned (text extraction is too small).
OCR_PDF_MAX_PAGES=10

# Set to 0 to load all rows.
CSV_MAX_ROWS=5000
SQLITE_MAX_ROWS_PER_TABLE=5000


# -----------------------------
# OCR Configuration (optional)
# -----------------------------
# If tesseract isn't on PATH, set the full path to the tesseract binary.
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# If Poppler isn't on PATH (commonly on Windows), set the folder that contains pdfinfo/pdftoppm.
# Windows example:
# POPPLER_PATH=C:\poppler\Library\bin
POPPLER_PATH=


# -----------------------------
# Streamlit (optional)
# -----------------------------
# If your Streamlit UI needs to know where the API is running, set it here.
# STREAMLIT_API_URL=http://localhost:8000
STREAMLIT_API_URL=

# -----------------------------
# Database / Auth
# -----------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_chatbot
AUTO_CREATE_TABLES=false
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
